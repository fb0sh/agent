# Copy to `.env` and fill in your own key. `.env` is git-ignored.
#
# Any OpenAI-compatible endpoint works.
MINI_AGENT_BASE_URL=https://api.commandcode.ai/provider/v1
MINI_AGENT_API_KEY=your-api-key
MINI_AGENT_MODEL=deepseek/deepseek-v4.1-flash

# Optional
# MINI_AGENT_CWD=.
# MINI_AGENT_MAX_ITERATIONS=32
